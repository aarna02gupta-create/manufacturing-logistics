table fact_shipment
	lineageTag: 24076028-f842-4f30-8497-a5b3fa252560

	measure 'Total Shipments' = COUNTROWS(fact_shipment)
		formatString: 0
		lineageTag: 6a459a58-f40a-4d67-9e80-2ac76b40f58c

	measure 'Recorded Freight INR' =
			
			SUM(fact_shipment[recorded_freight_inr])
		formatString: #,0.00
		lineageTag: 0a3a24f1-7508-40ab-8ee9-847492baae93

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Modeled Baseline INR' =
			
			SUM(fact_shipment[modeled_baseline_inr])
		formatString: #,0.00
		lineageTag: c772c014-5b80-4736-8aae-45a603da5a93

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cost Variance INR' =
			
			[Recorded Freight INR] - [Modeled Baseline INR]
		formatString: #,0.00
		lineageTag: a2c4bafb-1a94-4a62-8518-d1e60221c37e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cost Variance %' =
			
			DIVIDE([Cost Variance INR], [Modeled Baseline INR])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d345f54e-ef8e-49ca-ae2e-c8106263b03f

	measure 'Delayed Shipments' = COALESCE(CALCULATE([Total Shipments], FILTER(fact_shipment, NOT ISBLANK(fact_shipment[actual_delivery_date]) && NOT ISBLANK(fact_shipment[promised_delivery_date]) && fact_shipment[actual_delivery_date] > fact_shipment[promised_delivery_date])), 0)
		formatString: 0
		lineageTag: fd387573-d06b-4308-8d3d-06f829564388

	measure 'On-Time Shipments' = COALESCE(CALCULATE([Total Shipments], FILTER(fact_shipment, NOT ISBLANK(fact_shipment[actual_delivery_date]) && NOT ISBLANK(fact_shipment[promised_delivery_date]) && fact_shipment[actual_delivery_date] <= fact_shipment[promised_delivery_date])), 0)
		formatString: 0
		lineageTag: a7338e68-0bc2-4e87-bc4c-964ec8e917f5

	measure 'On-Time Delivery %' = DIVIDE([On-Time Shipments], [Delivery-Evaluable Shipments])
		formatString: 0.00%
		lineageTag: f4d3ea08-5977-4229-8dda-79717625596a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Delay Days' = AVERAGEX(FILTER(fact_shipment, NOT ISBLANK(fact_shipment[actual_delivery_date]) && NOT ISBLANK(fact_shipment[promised_delivery_date]) && fact_shipment[actual_delivery_date] > fact_shipment[promised_delivery_date]), DATEDIFF(fact_shipment[promised_delivery_date], fact_shipment[actual_delivery_date], DAY))
		formatString: 0.00
		lineageTag: 907dfda0-921e-4537-bb7e-36ad26a6a21e

	measure 'Delivery-Evaluable Shipments' = [On-Time Shipments] + [Delayed Shipments]
		formatString: 0
		lineageTag: 077e2288-7115-4d5a-8d87-91efad400027

	measure 'Missing Delivery Dates' = [Total Shipments] - [Delivery-Evaluable Shipments]
		formatString: 0
		lineageTag: 66635c1c-66b5-4a25-8710-4693bb7d3980

	measure 'Freight per Shipment INR' = DIVIDE([Recorded Freight INR], [Total Shipments])
		formatString: #,0.00
		lineageTag: a7656427-bb8c-4541-9001-b671a7b29109

	measure 'Delay Rate %' = DIVIDE([Delayed Shipments], [Delivery-Evaluable Shipments])
		formatString: 0.00%
		lineageTag: 8c648782-1949-413d-809d-3afeec0027b8

	measure 'Delivery Date Coverage %' = DIVIDE([Delivery-Evaluable Shipments], [Total Shipments])
		formatString: 0.00%
		lineageTag: 3f72783f-8046-4877-b603-c3467110a08f

